# Copy this file to secrets/env and edit it for harness-only settings.
#
# Values in secrets/env are visible to the untrusted harness process. Do not
# put provider gateway credentials, Docker credentials, host API tokens, or
# other secrets here unless you intentionally want the harness to read them.
#
# Provider credentials belong in secrets/provider_token and are injected by the
# proxy, not by the harness.

# Claude Code may require a syntactic API key to choose API-key mode. Use a
# non-secret placeholder; the proxy strips it and injects the real provider key.
# ANTHROPIC_API_KEY=sk-ant-api03-placeholder

# Codex may require a syntactic API key for OpenAI-compatible provider mode.
# Use a non-secret placeholder; the proxy injects the real provider key.
# OPENAI_API_KEY=sk-placeholder
